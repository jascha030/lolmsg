#!/usr/bin/env zsh

emulate -L zsh
setopt err_return no_unset pipe_fail

zmodload -F zsh/terminfo b:echoti || {
    print -u2 -- "${0:t}: failed to load zsh/terminfo builtin: echoti"
    exit 1
}

[[ -n ${1-} ]] || {
    print -u2 -- "usage: ${0:t} <message>"
    exit 1
}

[[ -t 0 && -t 1 ]] || {
    print -u2 -- "${0:t}: stdin and stdout must be ttys"
    exit 1
}

local msg=$1
local -i intro_cursor_hidden=0
local -i intro_alt_screen=0

require_dependencies() {
    local cmd

    for cmd in stty figlet lolcrab neo; do
        (( $+commands[$cmd] )) || {
            print -u2 -- "${0:t}: required command not found: $cmd"
            return 1
        }
    done
}

pad_lines() {
    local -i n=${1:-0}
    (( n > 0 )) || return 0
    repeat $n print
}

update_tty_size() {
    local -a size

    size=(${(s: :)$(stty size </dev/tty 2>/dev/null)}) || return 1
    (( ${#size} == 2 )) || return 1
    [[ $size[1] == <-> && $size[2] == <-> ]] || return 1

    LINES=$size[1]
    COLUMNS=$size[2]
}

output_fig() {
    local rendered_output=$1
    local scheme=0
    local grad

    if (( $+functions[is_dark] )); then
        scheme=$(is_dark 2>/dev/null) || scheme=0
    fi

    [[ $scheme == 1 ]] && grad=rainbow || grad=warm

    if (( ! ${+MYVIMRC} )); then
        echoti blink 2>/dev/null || true
    fi

    print -r -- "$rendered_output" | lolcrab -g "$grad"
}

print_lolmsg_output() {
    local msg=$1
    local prompt=${2-}
    local fig_output
    local -a fig_lines
    local -i fig_height gap total_height start_row
    local -i prompt_row prompt_col

    fig_output=$(figlet -Lcw "$COLUMNS" -f roman -- "$msg") || return 1
    fig_lines=(${(f)fig_output})

    fig_height=${#fig_lines}
    gap=2
    total_height=fig_height

    [[ -n $prompt ]] && (( total_height += gap + 1 ))

    start_row=$(( (LINES - total_height) / 2 ))
    (( start_row < 0 )) && start_row=0

    pad_lines $start_row
    output_fig "$fig_output" || return 1
    print

    [[ -n $prompt ]] || return 0

    prompt_row=$(( start_row + fig_height + gap ))
    prompt_col=$(( (COLUMNS - ${#prompt}) / 2 ))

    (( prompt_col < 0 )) && prompt_col=0
    (( prompt_row < 0 )) && prompt_row=0
    (( prompt_row >= LINES )) && prompt_row=$(( LINES - 1 ))

    echoti cup "$prompt_row" "$prompt_col" || return 1
    print -r -- "$prompt"
}

exit_intro() {
    if (( intro_alt_screen )); then
        echoti rmcup 2>/dev/null || true
        intro_alt_screen=0
    fi

    if (( intro_cursor_hidden )); then
        echoti cnorm 2>/dev/null || true
        intro_cursor_hidden=0
    fi
}

open_intro_screen() {
    local key
    local prev_cols prev_lines

    {
        echoti civis || return 1
        intro_cursor_hidden=1

        echoti smcup || return 1
        intro_alt_screen=1

        update_tty_size || return 1
        prev_cols=$COLUMNS
        prev_lines=$LINES

        while true; do
            echoti clear || return 1
            print_lolmsg_output "$msg" $'[ Press any key ]' || return 1

            while true; do
                if read -k1 -s -t 0.1 key </dev/tty 2>/dev/null; then
                    return 0
                fi

                update_tty_size || continue
                (( COLUMNS == prev_cols && LINES == prev_lines )) && continue
                break
            done

            prev_cols=$COLUMNS
            prev_lines=$LINES
        done
    } always {
        exit_intro
    }
}

run_matrix() {
    local msg=$1
    neo --message="$msg" -D --fps=80 -S 8 -s -F -a
}

main() {
    require_dependencies || return 1

    if (( RANDOM % 2 == 0 )); then
        run_matrix "$msg"
    else
        open_intro_screen
    fi
}

main "$@"