#!/usr/bin/env zsh

emulate -L zsh

local msg=$1
local ph=6

if (( ${+LOL_MSG_PROMPT_HEIGHT} )); then
    ph=$LOL_MSG_PROMPT_HEIGHT
fi

[[ -n $2 ]] && ph=$2

#---------------------------------------------------------------------------------------------------------------------#

function __pad_lines {
    local -i n=$1
    local -i i
    for (( i = 0; i < n; ++i )); do
        print
    done
}

function __update_tty_size {
    local -a size
    size=(${(s: :)$(stty size </dev/tty 2>/dev/null)})
    (( ${#size} == 2 )) || return 1

    LINES=$size[1]
    COLUMNS=$size[2]
}

# Print figlet, style depends on term being normal/vim-term.
function __output_fig {
    local text=$1
    local -i width=$2
    local curses=${3:-0}

    local _output
    _output=$(figlet -Lcw "$width" -f roman -- "$text")

    local _current_scheme _grad
    _current_scheme="$(is_dark)"
    [[ "$_current_scheme" == 0 ]] && _grad="warm" || _grad="rainbow"

    if (( ! ${+MYVIMRC} && curses == 0 )); then
        echoti blink
    fi

    print -r -- "$_output" | lolcrab -g "$_grad"
}

function __lolmsg_output {
    local -i top_pad=$1
    local text=$2
    local -i bottom_pad=$3
    local -i width=$4

    __pad_lines "$top_pad"
    __output_fig "$text" "$width" 0
    __pad_lines "$bottom_pad"
}

function __print_lolmsg_output {
    local -i t_cols=${COLUMNS}
    local -i t_lines=${LINES}

    local fig_output
    fig_output=$(figlet -Lcw "$t_cols" -f roman -- "$msg")

    local -a fig_lines
    fig_lines=("${(@f)fig_output}")

    local -i fig_height=${#fig_lines}
    local -i gap=2
    local -i total_height=$fig_height

    if [[ $# == 1 ]]; then
        total_height=$(( fig_height + gap + 1 ))
    fi

    local -i start_output_at=$(( (t_lines - total_height) / 2 ))
    (( start_output_at < 0 )) && start_output_at=0

    __lolmsg_output "$start_output_at" "$msg" 1 "$t_cols"

    if [[ $# == 1 ]]; then
        local prompt=$1
        local -i extra_text_pos=$(( start_output_at + fig_height + gap ))
        local -i render_pos=$(( (t_cols - ${#prompt}) / 2 ))

        (( render_pos < 0 )) && render_pos=0
        (( extra_text_pos < 0 )) && extra_text_pos=0
        (( extra_text_pos >= t_lines )) && extra_text_pos=$(( t_lines - 1 ))

        echoti cup "$extra_text_pos" "$render_pos"
        print -r -- "$prompt"
    fi
}

# (Experimental/W.I.P.) NCurses version.
function __open_curses_intro() {
    zmodload zsh/curses && {
        local i

        __update_tty_size || return 1

        zcurses init
        zcurses refresh

        echoti civis

        zcurses clear stdscr redraw
        zcurses refresh stdscr

        zcurses addwin intro "${LINES} ${COLUMNS}" 0 0
        zcurses scroll intro off
        zcurses attr intro blink

        zcurses string intro "$(__print_lolmsg_output $'[ Press any key ]')"
        zcurses refresh intro stdscr

        zcurses timeout intro 0

        until [[ $i == [\ ] ]]; do
            zcurses input intro i
        done
    } always {
        zcurses delwin intro
        echoti cnorm
        zcurses end
    }
}

function __with_i_msg {
    __print_lolmsg_output $'[ Press any key ]'
}

function __exit_intro {
    echoti rmcup
    echoti cnorm
}

function __open_matrix_screen {
    neo --message="Enter da HACKERMAN 030 Mode"
}

function __open_intro_screen {
    echoti civis
    echoti smcup

    {
        local key prev_cols prev_lines

        __update_tty_size || return 1
        prev_cols=$COLUMNS
        prev_lines=$LINES

        while true; do
            echoti clear
            __with_i_msg

            while true; do
                if read -k1 -s -t 0.1 key </dev/tty 2>/dev/null; then
                    return
                fi

                __update_tty_size || continue
                (( COLUMNS == prev_cols && LINES == prev_lines )) && continue
                break
            done

            prev_cols=$COLUMNS
            prev_lines=$LINES
        done
    } always {
        __exit_intro
    }
}

#---------------------------------------------------------------------------------------------------------------------#

function __run {
    local curses=${1:-0}

    if [[ "$curses" == "curses" ]]; then
        __open_curses_intro
    else
        if (( RANDOM % 2 == 0 )); then
            neo --message="Enter da HACKERMAN 030 Mode" -D --fps=80 -S 8 -s -F -a
        else
            __open_intro_screen
        fi
    fi
}

__run